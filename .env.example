# ==============================================================================
# BitesBro Cloud Kitchen Platform — Environment Variables Example
# ==============================================================================
# SECURITY NOTICE (AGENTS.md & docs/SECURITY.md):
# 1. This file contains PLACEHOLDERS ONLY. Never commit real keys or secrets.
# 2. Variables prefixed with VITE_ are embedded into public client JavaScript.
#    NEVER place service-role keys, payment secrets, or database passwords in VITE_ variables.
# 3. Backend secrets must be configured exclusively in Cloudflare Pages Secrets or
#    Supabase Edge Functions Environment Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Frontend Configuration (Vite / React PWA)
# ------------------------------------------------------------------------------
# Supabase Project API Gateway URL (e.g., https://your-project-ref.supabase.co or http://127.0.0.1:54321 for local CLI)
VITE_SUPABASE_URL=https://placeholder-project-ref.supabase.co

# Supabase Anonymous/Public Key (Safe for browser client; restricted by PostgreSQL RLS)
VITE_SUPABASE_ANON_KEY=placeholder-anon-public-key-safe-for-browser

# Optional Application Environment Indicator ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Trusted Backend & Edge Function Configuration (DO NOT EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# The variables below are for Supabase Edge Functions and local CLI server testing.
# In production, set these via: `supabase secrets set KEY=VALUE` or Cloudflare dashboard.
#
# SUPABASE_SERVICE_ROLE_KEY=placeholder-privileged-service-role-key-never-bundle-in-frontend
# PAYMENT_PROVIDER_WEBHOOK_SECRET=placeholder-payment-gateway-webhook-signing-secret
# PAYMENT_PROVIDER_API_KEY=placeholder-payment-gateway-server-api-key
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres